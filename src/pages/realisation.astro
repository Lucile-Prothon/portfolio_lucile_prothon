---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import Boussoleloupe from "../assets/img/boussoleloupe.svg";
import Fcom1 from "../assets/img/fcom1.svg";
import Fcom2 from "../assets/img/fcom2.svg";	
import Fcom3 from "../assets/img/fcom3.svg";
import Fcom4 from "../assets/img/fcom4.svg";
import Pdesing1 from "../assets/img/pdesign1.svg";
import Pdesing2 from "../assets/img/pdesign2.svg";
import Pdesing3 from "../assets/img/pdesign3.svg";
import Sdev1 from "../assets/img/sdev1.svg";
import Sdev2 from "../assets/img/sdev2.svg";
import Sdev3 from "../assets/img/sdev3.svg";
import Sdev4 from "../assets/img/sdev4.svg";
import Sdev5 from "../assets/img/sdev5.svg";

const projetsCommunication = [
    { numero: "01", titre: "Tiktok promotionnel", image: Fcom1, lien: "/tiktokpromo" },
   /* { numero: "02", titre: "Annonce discord", image: Fcom2 },
    { numero: "03", titre: "Gestion de communauté", image: Fcom3 },
    { numero: "04", titre: "Création fiche rp", image: Fcom4 },*/
];

const projetsDesignn = [
    { numero: "01", titre: "Création de logo", image: Pdesing1, lien: "/crealogo" },
   /* { numero: "02", titre: "Création d'affiche", image: Pdesing2 },
    { numero: "03", titre: "Montage vidéo", image: Pdesing3 },*/
];

const projetsDev = [
    { numero: "01", titre: "Création de logo", image: Sdev1, lien: "/riveterritoire" },
   /* { numero: "02", titre: "Les rives du territoire", image: Sdev2 },
    { numero: "03", titre: "Hidden Voices", image: Sdev3 },
	{ numero: "04", titre: "Olyvia", image: Sdev4 },
	{ numero: "05", titre: "RPG (Vaultlight Community)", image: Sdev4 }
	 { numero: "04", titre: "Visual novel (Hazel & Moka", image: Sdev5 },*/
];
---

<Layout title="Réalisations | Portfolio de Lucile Prothon">
	<div class="relative flex min-h-[220px] items-center bg-header px-4 text-text1 sm:min-h-[clamp(250px,40vh,390px)]">
		<h1 class="absolute right-3 left-2 text-center font-teko text-h1 leading-tight">Réalisation</h1>
		<Image
			src={Boussoleloupe}
			alt="Illustration d'une boussole et d'une loupe"
			class="absolute right-[3%] top-1/2 h-auto w-[clamp(92px,20vw,250px)] -translate-y-1/2"
		/>
	</div>

	<main class="bg-background px-4 pb-12 pt-8 text-text1 sm:px-6 sm:pt-[clamp(3rem,8vw,7.5rem)]">
		<header class="text-center">
			<h2 class="font-pragati-narrow text-h2 leading-tight">Un monde merveilleux</h2>
			<p class="mt-2 font-platypi text-sous-intro leading-snug">
				Des réalisations que j'ai produites, ayant été réalisées lors de quêtes
			</p>
		</header>

		<section id="communication" class="scroll-mt-6 mt-[clamp(3rem,6vw,6rem)]">
			<h2 class="text-center font-cinzel-decorative text-titre font-bold uppercase leading-tight text-text3">
				I. Communication
			</h2>
			<div class="mx-auto mt-8 grid w-full max-w-[800px] grid-cols-[93px] justify-center gap-x-6 gap-y-8 sm:mt-[clamp(2rem,7vw,6.5rem)] sm:grid-cols-2 sm:justify-normal lg:grid-cols-3">
				{projetsCommunication.map((projet) => (
					<a href={projet.lien} class="group relative block h-[90px] w-[93px] aspect-auto text-text1 no-underline focus-visible:outline-2 focus-visible:outline-offset-2 sm:h-auto sm:w-auto sm:aspect-[349/337]" aria-label={`${projet.numero} ${projet.titre}`}>
						<svg
							viewBox="0 0 349 337"
							class="absolute inset-0 z-0 h-full w-full"
							aria-hidden="true"
						>
							<path
								d="M34 1.5h281c17.949 0 32.5 14.55 32.5 32.5v230.115c0 17.95-14.551 32.5-32.5 32.5H34c-17.95 0-32.5-14.55-32.5-32.5V34C1.5 16.05 16.05 1.5 34 1.5z"
								fill="#D3A46A"
								stroke="#9C8565"
								stroke-width="3"
							/>
						</svg>
						<div class="folder-flap absolute inset-0 z-10">
							<svg
								viewBox="0 0 349 337"
								class="absolute inset-0 h-full w-full"
								aria-hidden="true"
							>
								<path d="M18.95 22.683H330.05V315.128H18.95z" fill="#C9DBC4" />
							</svg>
							<Image
								src={projet.image}
								alt=""
								aria-hidden="true"
								class="absolute left-[19%] top-[3%] h-[88%] w-[62%] object-cover"
							/>
						</div>
						<svg
							viewBox="0 0 349 337"
							class="absolute inset-0 z-20 h-full w-full"
							aria-hidden="true"
						>
							<path
								d="M21.223 152.91C9.833 153.046.646 163.842.586 177.158.432 212.184.146 276.765 0 310.266c-.051 11.859 8.081 21.553 18.223 21.72l300.928 4.985c8.162.136 17.559.073 23.149-6.88 5.591-6.951 6.863-20.154 6.245-29.671-1.929-29.679 1.668-69.404 0-95.067-.887-13.662-16.952-25.211-28.673-25.03-50.03.768-172.779 2.66-172.779 2.66-15.56-2.811-30.824-9.355-40.638-22.618-3.825-5.183-9.407-8.134-15.26-8.066-16.369-.022-48.713.36-69.972.611z"
								fill="#D3A46A"
								stroke="#9C8565"
								stroke-width="3"
							/>
						</svg>
						<p class="absolute left-[5%] top-[48%] z-30 font-pridi text-[10px] font-bold leading-none sm:text-titre-card">
							{projet.numero}
						</p>
						<p class="absolute left-[8%] top-[74%] z-30 font-platypi text-[7px] leading-tight sm:text-body">
							{projet.titre}
						</p>
					</a>
				))}
			</div>
		</section>

		<section id="design-graphique" class="scroll-mt-6 mt-12">
			<h2 class="text-center font-cinzel-decorative text-titre font-bold uppercase leading-tight text-text3">II. Design graphique</h2>
			<div class="mx-auto mt-[clamp(2rem,7vw,6.5rem)] grid w-full max-w-[800px] grid-cols-[93px] justify-center gap-x-6 gap-y-8 sm:grid-cols-2 sm:justify-normal lg:grid-cols-3">
				{projetsDesignn.map((projet) => (
					<a href={projet.lien} class="group relative block h-[90px] w-[93px] aspect-auto text-text1 no-underline focus-visible:outline-2 focus-visible:outline-offset-2 sm:h-auto sm:w-auto sm:aspect-[349/337]" aria-label={`${projet.numero} ${projet.titre}`}>
						<svg
							viewBox="0 0 349 337"
							class="absolute inset-0 z-0 h-full w-full"
							aria-hidden="true"
						>
							<path
								d="M34 1.5h281c17.949 0 32.5 14.55 32.5 32.5v230.115c0 17.95-14.551 32.5-32.5 32.5H34c-17.95 0-32.5-14.55-32.5-32.5V34C1.5 16.05 16.05 1.5 34 1.5z"
								fill="#D3A46A"
								stroke="#9C8565"
								stroke-width="3"
							/>
						</svg>
						<div class="folder-flap absolute inset-0 z-10">
							<svg
								viewBox="0 0 349 337"
								class="absolute inset-0 h-full w-full"
								aria-hidden="true"
							>
								<path d="M18.95 22.683H330.05V315.128H18.95z" fill="#C9DBC4" />
							</svg>
							<Image
								src={projet.image}
								alt=""
								aria-hidden="true"
								class="absolute left-[19%] top-[3%] h-[88%] w-[62%] object-cover"
							/>
						</div>
						<svg
							viewBox="0 0 349 337"
							class="absolute inset-0 z-20 h-full w-full"
							aria-hidden="true"
						>
							<path
								d="M21.223 152.91C9.833 153.046.646 163.842.586 177.158.432 212.184.146 276.765 0 310.266c-.051 11.859 8.081 21.553 18.223 21.72l300.928 4.985c8.162.136 17.559.073 23.149-6.88 5.591-6.951 6.863-20.154 6.245-29.671-1.929-29.679 1.668-69.404 0-95.067-.887-13.662-16.952-25.211-28.673-25.03-50.03.768-172.779 2.66-172.779 2.66-15.56-2.811-30.824-9.355-40.638-22.618-3.825-5.183-9.407-8.134-15.26-8.066-16.369-.022-48.713.36-69.972.611z"
								fill="#D3A46A"
								stroke="#9C8565"
								stroke-width="3"
							/>
						</svg>
						<p class="absolute left-[5%] top-[48%] z-30 font-pridi text-[10px] font-bold leading-none sm:text-titre-card">
							{projet.numero}
						</p>
						<p class="absolute left-[8%] top-[74%] z-30 font-platypi text-[7px] leading-tight sm:text-body">
							{projet.titre}
						</p>
					</a>
				))}
			</div>
		</section>
		<section id="developpement-web" class="scroll-mt-6 mt-12">
			<h2 class="text-center font-cinzel-decorative text-titre font-bold uppercase leading-tight text-text3">III. Développement web</h2>
			<div class="mx-auto mt-[clamp(2rem,7vw,6.5rem)] grid w-full max-w-[800px] grid-cols-[93px] justify-center gap-x-6 gap-y-8 sm:grid-cols-2 sm:justify-normal lg:grid-cols-3">
				{projetsDev.map((projet) => (
					<a href={projet.lien} class="group relative block h-[90px] w-[93px] aspect-auto text-text1 no-underline focus-visible:outline-2 focus-visible:outline-offset-2 sm:h-auto sm:w-auto sm:aspect-[349/337]" aria-label={`${projet.numero} ${projet.titre}`}>
						<svg
							viewBox="0 0 349 337"
							class="absolute inset-0 z-0 h-full w-full"
							aria-hidden="true"
						>
							<path
								d="M34 1.5h281c17.949 0 32.5 14.55 32.5 32.5v230.115c0 17.95-14.551 32.5-32.5 32.5H34c-17.95 0-32.5-14.55-32.5-32.5V34C1.5 16.05 16.05 1.5 34 1.5z"
								fill="#D3A46A"
								stroke="#9C8565"
								stroke-width="3"
							/>
						</svg>
						<div class="folder-flap absolute inset-0 z-10">
							<svg
								viewBox="0 0 349 337"
								class="absolute inset-0 h-full w-full"
								aria-hidden="true"
							>
								<path d="M18.95 22.683H330.05V315.128H18.95z" fill="#C9DBC4" />
							</svg>
							<Image
								src={projet.image}
								alt=""
								aria-hidden="true"
								class="absolute left-[19%] top-[3%] h-[88%] w-[62%] object-cover"
							/>
						</div>
						<svg
							viewBox="0 0 349 337"
							class="absolute inset-0 z-20 h-full w-full"
							aria-hidden="true"
						>
							<path
								d="M21.223 152.91C9.833 153.046.646 163.842.586 177.158.432 212.184.146 276.765 0 310.266c-.051 11.859 8.081 21.553 18.223 21.72l300.928 4.985c8.162.136 17.559.073 23.149-6.88 5.591-6.951 6.863-20.154 6.245-29.671-1.929-29.679 1.668-69.404 0-95.067-.887-13.662-16.952-25.211-28.673-25.03-50.03.768-172.779 2.66-172.779 2.66-15.56-2.811-30.824-9.355-40.638-22.618-3.825-5.183-9.407-8.134-15.26-8.066-16.369-.022-48.713.36-69.972.611z"
								fill="#D3A46A"
								stroke="#9C8565"
								stroke-width="3"
							/>
						</svg>
						<p class="absolute left-[5%] top-[48%] z-30 font-pridi text-[10px] font-bold leading-none sm:text-titre-card">
							{projet.numero}
						</p>
						<p class="absolute left-[8%] top-[74%] z-30 font-platypi text-[7px] leading-tight sm:text-body">
							{projet.titre}
						</p>
					</a>
				))}
			</div>
		</section>
	</main>
</Layout>

<style>
	.folder-flap {
		transform-origin: 50% 100%;
		transition: transform 300ms ease-out;
	}

	.group:hover .folder-flap {
		transform: translateY(-12px);
	}

	@media (prefers-reduced-motion: reduce) {
		.folder-flap {
			transition: none;
		}
	}
</style>
