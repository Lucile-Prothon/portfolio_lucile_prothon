
---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import Champi_rouge from "../assets/img/champi_rouge.svg";
import Avatar2 from "../assets/img/avatar2.svg";
import Stat1 from "../assets/icons/stat1.svg";
import Stat2 from "../assets/icons/stat2.svg";
import Stat3 from "../assets/icons/stat3.svg";
import Stat4 from "../assets/icons/stat4.svg";
import Stat5 from "../assets/icons/stat5.svg";
import StatTel1 from "../assets/img/stattel1.svg";
import StatTel2 from "../assets/img/stattel2.svg";
import StatTel3 from "../assets/img/stattel3.svg";
import StatTel4 from "../assets/img/stattel4.svg";
import StatTel5 from "../assets/img/stattel5.svg";
import Bougie from "../assets/img/bougie.svg";
import Trefle from "../assets/img/trefle.svg";
import Ampoule from "../assets/img/ampoule.svg";
import Telechargement from "../assets/icons/telechargement.svg"
---

<Layout title="Profil | Portfolio de Lucile Prothon">
  <div class="relative flex min-h-[160px] flex-col items-start bg-header px-6 pt-6 text-text1 sm:min-h-[clamp(180px,30vh,240px)] sm:items-center sm:px-4 sm:pt-4">
    <h1 class="text-left font-teko text-h1 leading-tight sm:text-center">Profil</h1>
    <Image
      src={Champi_rouge}
      alt="Illustration d'un champignon rouge"
      class="absolute right-4 bottom-3 h-auto w-[clamp(95px,29vw,140px)] sm:right-7 sm:w-[clamp(110px,16vw,140px)]"
    />
  </div>

  <div class="bg-background px-4 pb-12 pt-8 text-text1 sm:px-6">
    <h2 class="text-center font-pragati-narrow text-h2 leading-tight">
      Une mise en abime
    </h2>
    <p class="mt-2 text-center font-platypi text-sous-intro leading-snug">
      En apprendre plus sur votre personnage est essentiel
    </p>

    <section class="mx-auto mt-10 w-full max-w-[1100px] border-0 p-0 md:mt-14 md:rounded-[32px] md:border-5 md:border-fiche-profil md:p-8">
      <div class="profile-summary rounded-[26px] border-3 border-fiche-profil p-4 md:rounded-none md:border-0 md:p-0">
      <div class="grid grid-cols-[minmax(90px,0.36fr)_minmax(0,1fr)] gap-x-3 gap-y-4 sm:grid-cols-[138px_minmax(0,1fr)] sm:gap-x-8 md:gap-6 md:grid-cols-[138px_minmax(0,1fr)] md:gap-x-12">
        <Image
          src={Avatar2}
          alt="Avatar type réseaux sociaux"
          width={138}
          height={148}
          class="mx-auto h-auto w-full max-w-[108px] object-contain sm:mx-0 sm:max-w-[138px] md:h-[148px] md:w-[138px]"
        />

        <div>
          <h3 class="mb-3 text-left font-pridi text-titre-card leading-tight md:mb-4">
            FICHE PERSONNAGE
          </h3>
          <div class="space-y-2 break-words text-left font-platypi text-body leading-snug sm:space-y-3">
            <p>Identification : Lucile Prothon</p>
            <p>Statut : Étudiante</p>
            <p>Études : 2e année de BUT Métiers du multimédia et de l'internet</p>
            <p>Disponibilité : <strong>Alternance, stage</strong></p>
          </div>
        </div>
      </div>

      <div class="mt-6 grid grid-cols-1 gap-6 md:mt-8 md:grid-cols-2 md:gap-x-12">
        <section>
          <h3 class="mb-3 text-left font-pridi text-titre-card leading-tight md:text-left">
            Compétences
          </h3>

         <ul class="w-full max-w-[500px] space-y-2 font-platypi text-body">
          <li class="grid min-w-0 grid-cols-[minmax(0,1fr)_minmax(72px,38%)] items-center gap-2 sm:grid-cols-[minmax(0,1fr)_minmax(100px,265px)]">
          <span class="min-w-0 break-words">Gestion de communauté</span>
          <StatTel1 aria-hidden="true" class="block h-auto w-full min-w-0 overflow-visible md:hidden -translate-x-5" />
          <Stat1 aria-hidden="true" class="hidden h-auto w-full md:block" />
          </li>
            <li class="grid min-w-0 grid-cols-[minmax(0,1fr)_minmax(72px,38%)] items-center gap-2 sm:grid-cols-[minmax(0,1fr)_minmax(100px,265px)]">
              <span class="min-w-0 break-words">Développement web</span>
              <StatTel2 aria-hidden="true" class="block h-auto w-full min-w-0 overflow-visible md:hidden -translate-x-5" />
              <Stat2 aria-hidden="true" class="hidden h-auto w-full md:block" />
            </li>
            <li class="grid min-w-0 grid-cols-[minmax(0,1fr)_minmax(72px,38%)] items-center gap-2 sm:grid-cols-[minmax(0,1fr)_minmax(100px,265px)]">
              <span class="min-w-0 break-words">Montage vidéo</span>
              <StatTel3 aria-hidden="true" class="block h-auto w-full min-w-0 overflow-visible md:hidden -translate-x-5" />
              <Stat3 aria-hidden="true" class="hidden h-auto w-full md:block" />
            </li>
            <li class="grid min-w-0 grid-cols-[minmax(0,1fr)_minmax(72px,38%)] items-center gap-2 sm:grid-cols-[minmax(0,1fr)_minmax(100px,265px)]">
              <span class="min-w-0 break-words">Création graphique</span>
              <StatTel4 aria-hidden="true" class="block h-auto w-full min-w-0 overflow-visible md:hidden -translate-x-5" />
              <Stat4 aria-hidden="true" class="hidden h-auto w-full md:block" />
            </li>
            <li class="grid min-w-0 grid-cols-[minmax(0,1fr)_minmax(72px,38%)] items-center gap-2 sm:grid-cols-[minmax(0,1fr)_minmax(100px,265px)]">
              <span class="min-w-0 break-words">Rédaction</span>
              <StatTel5 aria-hidden="true" class="block h-auto w-full min-w-0 overflow-visible md:hidden -translate-x-5" />
              <Stat5 aria-hidden="true" class="hidden h-auto w-full md:block" />
            </li>
          </ul>
        </section>
        <section>
          <h3 class="mb-3 text-left font-pridi text-titre-card leading-tight md:text-left">
            Outils
          </h3>

          <ul class="space-y-2 font-platypi text-body">
            <li>Figma, Affinity</li>
            <li>HTML, CSS, Astro, Tailwind</li>
            <li>Discord, TikTok, Instagram</li>
            <li>CapCut, DaVinci Resolve</li>
            <li>PocketBase</li>
            <li>WordPress</li>
            <li>Jira</li>
          </ul>
        </section>
      </div>
      </div>
		<section class="profile-story mt-6 grid min-w-0 grid-cols-[24px_minmax(0,1fr)] items-start gap-x-2 rounded-[24px] border-2 border-fiche-profil p-4 md:mt-8 md:grid-cols-[46px_minmax(0,1fr)] md:gap-x-3 md:rounded-none md:border-0 md:p-0">
        <Image
          src={Bougie}
          alt="Illustration d'une bougie allumée"
          width={46}
          height={75}
          class="row-span-2 h-auto w-6 object-contain md:w-[46px]"/>
		<h3 class="mb-3 min-w-0 text-left font-pridi text-[clamp(1.05rem,5vw,1.35rem)] font-bold leading-tight md:text-[25px]">Qui suis-je ? </h3>
		<p class="min-w-0 text-left font-platypi text-body leading-snug">Étudiante en deuxième année d’un BUT Métiers du Multimédia et de l’Internet (MMI), je recherche une alternance en communication. J’ai pu développer de nombreuses compétences en autodidacte comme au cours de ma formation. J’aime imaginer et donner vie à des univers. Produire du contenu en ligne ne me fait pas peur, bien au contraire. Je gère de nombreuses communautés en ligne, notamment sur Discord, pour lesquelles je suis amenée à communiquer vis-à-vis de mon rôle de staff. Je suis d’une nature curieuse, j’apprécie découvrir de nouvelles choses, que ce soit pour ma culture ou à but de m’en servir.</p>
		</section>
		<section class="profile-story mt-6 grid min-w-0 grid-cols-[24px_minmax(0,1fr)] items-start gap-x-2 rounded-[24px] border-2 border-fiche-profil p-4 md:mt-8 md:grid-cols-[46px_minmax(0,1fr)] md:gap-x-3 md:rounded-none md:border-0 md:p-0">
		<Image
          src={Trefle}
          alt="Illustration d'un trèfle inspiré du jeu vidéo One shot"
          width={46}
          height={75}
          class="row-span-2 h-auto w-6 object-contain md:w-[46px]"
        />
		<h3 class="mb-3 min-w-0 text-left font-pridi text-[clamp(1.05rem,5vw,1.35rem)] font-bold leading-tight md:text-[25px]">Mon parcours </h3>
		<p class="min-w-0 text-left font-platypi text-body leading-snug">Je possède un bac STMG avec l’option Systèmes d’Information de Gestion (SIG) qui m’a par la suite confirmé mon choix de poursuite d’études dans ma formation actuelle. Ce qui m’a donné envie de la rejoindre est la diversité et la polyvalence qu’elle offre. En effet, nous obtenons des compétences en communication, en design mais également en développement web. Elle répondait parfaitement à mon envie de travailler dans le milieu du numérique et, plus récemment, d’évoluer dans le domaine de la communication.</p>
	  </section>
	<section class="profile-story mt-6 grid min-w-0 grid-cols-[24px_minmax(0,1fr)] items-start gap-x-2 rounded-[24px] border-2 border-fiche-profil p-4 md:mt-8 md:grid-cols-[46px_minmax(0,1fr)] md:gap-x-3 md:rounded-none md:border-0 md:p-0">
        <Image
          src={Ampoule}
          alt="Illustration d'une ampoule inspiré du jeu vidéo One shot"
          width={46}
          height={75}
          class="row-span-2 h-auto w-6 object-contain md:w-[46px]"
        />
		<h3 class="mb-3 min-w-0 text-left font-pridi text-[clamp(1.05rem,5vw,1.35rem)] font-bold leading-tight md:text-[25px]">Mes centres d’interêts ?</h3>
		<p class="min-w-0 text-left font-platypi text-body leading-snug">Discord est une plateforme qui me passionne, tant par son fonctionnement que son utilisation. Au fil des ans, j’ai su créer divers serveurs, univers et communautés. Cet attrait plus que prononcé pour cette application m’a notamment fait découvrir le roleplay (rp), qui consiste à créer et donner vie à des personnages fictifs dans des histoires que nous écrivons. Cette pratique a pu m’aider vis-à-vis de ma manière de parler, à savoir facilement m’adapter à mon interlocuteur et à me mettre à la place d’une personne pouvant lire ce que j’écrivais. Les jeux vidéo, la lecture et la musique sont également des activités que j’apprécie faire, mais ce que j’aime par-dessus tout, c’est effectuer mon rôle de staff dans les différents projets que je gère sur Discord, cela passe par la sécurisation, la création de ces serveurs mais aussi l’écriture d’annonces pour informer de divers événements ou simplement discuter avec les membres. Comme dit précédemment, j’aime mettre en place mes idées et créer ce que je peux par la suite. J’aime également créer de petits montages vidéo que je publie sur Instagram.</p>
	  </section>
	  	<a href="/cv_lucile_prothon.pdf" download="cv_lucile_prothon.pdf" class="ml-auto mt-10 flex w-fit items-center justify-center gap-2 font-oxanium text-btn text-text1">
			<Telechargement aria-hidden="true" class=" shrink-0" />Télécharger mon cv</a>
    </section>
  </div>
</Layout>
