---
import Layout from "../layouts/Layout.astro";
import Start from "../assets/icons/start.svg";
import {Image} from "astro:assets";
import Champi_marron from "../assets/img/champi_marron.svg";
import Badge from "../assets/icons/badge.svg";
import Avatar from "../assets/img/avatar.svg";
import Stat1 from "../assets/icons/stat1.svg";
import Stat2 from "../assets/icons/stat2.svg";
import Stat3 from "../assets/icons/stat3.svg";
import Stat4 from "../assets/icons/stat4.svg";
import Stat5 from "../assets/icons/stat5.svg";
import StatTel1 from "../assets/img/stattel1.svg";
import StatTel2 from "../assets/img/stattel2.svg";
import StatTel3 from "../assets/img/stattel3.svg";
import StatTel4 from "../assets/img/stattel4.svg";
import StatTel5 from "../assets/img/stattel5.svg";
import Rondin from "../assets/img/rondin.svg";
---
<Layout title="Accueil | Portfolio de Lucile Prothon">
	<div class="relative flex min-h-[240px] flex-col items-center bg-header px-4 pt-4 text-text1 sm:min-h-[clamp(300px,70vh,520px)]">
		<h1 class="relative z-10 mt-5 max-w-[15ch] text-center font-teko text-h1 leading-tight sm:mt-0 sm:max-w-none">Étudiante en communication</h1>
		<a href="/realisation" class="relative z-10 mt-6 inline-flex h-[46px] w-[168px] items-center justify-center gap-2 rounded-[12px] border-4 border-btn-border-start bg-btn-start font-oxanium text-[clamp(1rem,4vw,1.25rem)] text-text2 sm:mt-12 sm:text-[20px]">
			<Start aria-hidden="true" class="h-5 w-[17px] shrink-0" />Explorer
		</a>
		<Image
			src={Champi_marron}
			alt="Illustration d'un champignon marron"
			class="absolute right-2 top-2 h-auto w-[clamp(80px,20vw,240px)] rotate-17 sm:top-12"
		/>
	</div>
	<div class="bg-background px-6 pb-12 pt-14 text-text1">
		<h2 class="text-center font-pragati-narrow text-h2 leading-tight">Bienvenue dans mon univers</h2>
		<p class="mt-2 text-center font-platypi text-sous-intro leading-snug">
			Découvrez mon parcours, mes créations et mes compétences
		</p>

		<section class="mt-14">
			<h3 class="text-center font-pridi text-titre-card font-bold leading-tight">RÉALISATION</h3>
			<div class="mx-auto mt-8 grid w-full max-w-[1320px] grid-cols-1 gap-6 sm:mt-10 sm:grid-cols-2 sm:gap-7 lg:grid-cols-3">
				<div class="hover-3d relative w-full rounded-[32px] text-text1 sm:rounded-[36px]">

					<article class="relative flex min-h-[172px] flex-col rounded-[32px] border-[3px] border-btn-border-debloquer px-4 py-4 pb-14 sm:min-h-[240px] sm:rounded-[36px] sm:py-3 sm:pb-3">

						<p class="text-center font-cinzel-decorative text-titre-card font-bold uppercase leading-tight text-text3">
							Communication
						</p>

						<p class="mt-5 font-platypi text-body leading-[1.4]">
							Une idée, un message à transmettre à l’aide de différents canaux.
						</p>

					</article>

					<!-- Éléments nécessaires à l'effet 3D DaisyUI -->
					<div></div>
					<div></div>
					<div></div>
					<div></div>
					<div></div>
					<div></div>
					<div></div>
					<div></div>

					<a
						href="/realisation#communication"
						aria-label="Voir les projets de communication"
						class="card-link absolute inset-0 z-10 rounded-[32px] focus-visible:outline-2 focus-visible:outline-offset-4 sm:rounded-[36px]"
					></a>

					<a
						href="/realisation#communication"
						class="card-action inline-flex h-[30px] items-center gap-1 rounded-[6px] border border-text1 bg-btn-debloquer pl-2 pr-1 font-oxanium text-btn leading-none text-text1 focus-visible:outline-2 focus-visible:outline-offset-2"
					>
						Débloquer <Badge aria-hidden="true" class="ml-1 shrink-0" />
					</a>

				</div>

				<div class="hover-3d relative w-full rounded-[32px] text-text1 sm:rounded-[36px]">
				<article class="flex min-h-[172px] flex-col rounded-[32px] border-[3px] border-btn-border-debloquer px-4 py-4 pb-14 sm:min-h-[240px] sm:rounded-[36px] sm:py-3 sm:pb-3">
					<p class="text-center font-cinzel-decorative text-titre-card font-bold uppercase leading-tight text-text3">Design graphique</p>
					<p class="mt-5 font-platypi text-body leading-[1.4]">Façonner des univers, appuyer des idées. Créer tout simplement.</p>
				</article>
				<!-- Éléments nécessaires à l'effet 3D DaisyUI -->
  				<div></div>
				<div></div>
				<div></div>
				<div></div>
				<div></div>
				<div></div>
				<div></div>
				<div></div>
				<a href="/realisation#design-graphique" aria-label="Voir les projets de design graphique" class="card-link absolute inset-0 z-10 rounded-[32px] focus-visible:outline-2 focus-visible:outline-offset-4 sm:rounded-[36px]"></a>
				<a href="/realisation#design-graphique" class="card-action inline-flex h-[30px] items-center gap-1 rounded-[6px] border border-text1 bg-btn-debloquer pl-2 pr-1 font-oxanium text-btn leading-none text-text1 focus-visible:outline-2 focus-visible:outline-offset-2">
					Débloquer <Badge aria-hidden="true" class="ml-1 shrink-0" />
				</a>
				</div>
				<div class="hover-3d relative w-full rounded-[32px] text-text1 sm:rounded-[36px]">
				<article class="flex min-h-[172px] flex-col rounded-[32px] border-[3px] border-btn-border-debloquer px-4 py-4 pb-14 sm:min-h-[240px] sm:rounded-[36px] sm:py-3 sm:pb-3">
					<p class="text-center font-cinzel-decorative text-titre-card font-bold uppercase leading-tight text-text3">Développement web</p>
					<p class="mt-5 font-platypi text-body leading-[1.4]">Construire des interactions, chaque ligne de code s’approchant de cette idée.</p>
				</article>
				<!-- Éléments nécessaires à l'effet 3D DaisyUI -->
  				<div></div>
				<div></div>
				<div></div>
				<div></div>
				<div></div>
				<div></div>
				<div></div>
				<div></div>
				<a href="/realisation#developpement-web" aria-label="Voir les projets de développement web" class="card-link absolute inset-0 z-10 rounded-[32px] focus-visible:outline-2 focus-visible:outline-offset-4 sm:rounded-[36px]"></a>
				<a href="/realisation#developpement-web" class="card-action inline-flex h-[30px] items-center gap-1 rounded-[6px] border border-text1 bg-btn-debloquer pl-2 pr-1 font-oxanium text-btn leading-none text-text1 focus-visible:outline-2 focus-visible:outline-offset-2">
					Débloquer <Badge aria-hidden="true" class="ml-1 shrink-0" />
				</a>
				</div>
			</div>
		</section>

		<section class="mt-14">
			<h3 class="text-center font-pridi text-titre-card font-bold leading-tight">FICHE PERSONNAGE</h3>
			<div class="mx-auto mt-4 grid w-full max-w-[1100px] grid-cols-[minmax(138px,150px)_minmax(0,1fr)] gap-x-3 gap-y-6 sm:grid-cols-[150px_minmax(0,1fr)] sm:gap-x-8 md:items-center lg:grid-cols-[150px_minmax(0,1fr)_340px]">
				<div class="flex flex-col items-center gap-7 md:items-start">
					<Image
						src={Avatar}
						alt="Avatar type réseaux sociaux"
						width={138}
						height={148}
						class="h-auto aspect-[138/148] w-full max-w-[138px] object-contain"
					/>
					<a href="/profil" class="inline-flex min-h-10 w-full items-center justify-center whitespace-nowrap rounded-[13px] border-[3px] border-btn-menu px-1 py-1 text-center font-oxanium text-[clamp(0.7rem,2.4vw,0.9375rem)] leading-tight text-text1 sm:min-h-11 sm:border-[4px] sm:px-2 sm:py-2">
						Accéder au profil
					</a>
				</div>
				<div class="space-y-2 break-words text-left font-platypi text-body leading-snug sm:space-y-3">
					<p>Identification : Lucile Prothon</p>
					<p>Statut : Étudiant</p>
					<p>Étude : 2ème année Métier du multimédia et de l’internet</p>
					<p>Disponibilité : <strong>Alternance, stage</strong></p>
				</div>
				<div class="col-span-2 w-full md:col-span-2 lg:col-span-1">
					<h3 class="mb-3 text-center font-pridi text-[25px] font-bold leading-tight md:text-left">Compétences</h3>
					<ul class="space-y-2 font-platypi text-body">
						<li class="grid grid-cols-[minmax(0,1fr)_minmax(72px,38%)] items-center gap-2 sm:grid-cols-[minmax(0,1fr)_minmax(100px,198px)] sm:gap-3">
							<span>Gestion de communauté</span><StatTel1 aria-hidden="true" class="h-auto w-full md:hidden" /><Stat1 aria-hidden="true" class="hidden h-auto w-full md:block" />
						</li>
						<li class="grid grid-cols-[minmax(0,1fr)_minmax(72px,38%)] items-center gap-2 sm:grid-cols-[minmax(0,1fr)_minmax(100px,198px)] sm:gap-3">
							<span>Développement web</span><StatTel2 aria-hidden="true" class="h-auto w-full md:hidden" /><Stat2 aria-hidden="true" class="hidden h-auto w-full md:block" />
						</li>
						<li class="grid grid-cols-[minmax(0,1fr)_minmax(72px,38%)] items-center gap-2 sm:grid-cols-[minmax(0,1fr)_minmax(100px,198px)] sm:gap-3">
							<span>Montage vidéo</span><StatTel3 aria-hidden="true" class="h-auto w-full md:hidden" /><Stat3 aria-hidden="true" class="hidden h-auto w-full md:block" />
						</li>
						<li class="grid grid-cols-[minmax(0,1fr)_minmax(72px,38%)] items-center gap-2 sm:grid-cols-[minmax(0,1fr)_minmax(100px,198px)] sm:gap-3">
							<span>Création graphique</span><StatTel4 aria-hidden="true" class="h-auto w-full md:hidden" /><Stat4 aria-hidden="true" class="hidden h-auto w-full md:block" />
						</li>
						<li class="grid grid-cols-[minmax(0,1fr)_minmax(72px,38%)] items-center gap-2 sm:grid-cols-[minmax(0,1fr)_minmax(100px,198px)] sm:gap-3">
							<span>Rédaction</span><StatTel5 aria-hidden="true" class="h-auto w-full md:hidden" /><Stat5 aria-hidden="true" class="hidden h-auto w-full md:block" />
						</li>
					</ul>
				</div>
			</div>
		</section>
		<section class="mx-auto mt-14 grid min-h-[250px] w-full max-w-[700px] grid-cols-1 items-center gap-6 md:grid-cols-[300px_minmax(0,1fr)] md:gap-10">
			<Image
				src={Rondin}
				alt="Illustration d'un rondin de bois avec des champignons et de la mousse dessus"
				width={462}
				height={340}
				class="mx-auto h-auto w-[clamp(130px,28vw,280px)] max-w-full object-contain"
			/>
			<div class="flex min-h-[200px] flex-col">
				<h4 class="text-center font-pragati-narrow text-titre text-text1 md:text-left">Participez à l’aventure</h4>
				<p class="mt-5 font-platypi text-body text-text1">
					Contactez-moi si mon profil vous intéresse, si vous avez des idées de projets ou que vous voulez simplement discuter.
				</p>
				<a href="/contact" class="mt-auto inline-flex min-h-11 w-fit self-center items-center justify-center rounded-[12px] border-[4px] border-btn-menu px-4 py-1 font-oxanium text-btn text-text1 md:self-end">
					Entrer en contact
				</a>
			</div>
		</section>
	</div>
</Layout>

<style>
	.hover-3d {
		color: inherit;
	}

	.hover-3d > .card-action {
		grid-area: 3 / 3 / 4 / 4;
		z-index: 2;
		place-self: end;
		margin: 0 1rem 0.75rem 0;
	}

	.card-action {
		max-width: calc(100% - 2rem);
	}

	.card-action:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}
</style>
